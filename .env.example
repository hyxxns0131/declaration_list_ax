# declaration_list 환경 변수 예시 (값은 비워 두고 커밋한다)
# 실제 값은 같은 폴더의 .env 에 넣는다. .env 는 절대 커밋하지 않는다.
# 기준: SAMC 기존 도구(customs_bot) .env.example + 팀 결정(Next.js + FastAPI, Claude/GPT, Supabase 공개 정보만)
# 작성일: 2026-11-24 · 상태: 초안

# ─────────────────────────────────────────────
# 0. 로그인 (첫 화면. core/auth, RULES 7-4. weekly_report와 같은 이름)
# ─────────────────────────────────────────────
AUTH_ENABLED=true                  # 자동 테스트에서만 false. 시연·exe에서는 끄지 않는다
AUTH_SECRET_KEY=                       # 세션 토큰 서명용 긴 무작위 문자열. PC마다 새로 만든다
AUTH_SESSION_HOURS=12                   # 로그인 유지 시간
ADMIN_USERNAME=                    # 첫 실행 때 한 번만 어드민 계정 생성 (PM PC .env에만)
ADMIN_PASSWORD=            # 최초 비밀번호. 첫 로그인 때 바꾸게 함. 바꾼 뒤 지워도 됨
ADMIN_DISPLAY_NAME=관리자

# ─────────────────────────────────────────────
# 1. 실행 환경
# ─────────────────────────────────────────────
APP_ENV=local                      # local | demo
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:3000 # Next.js 개발 서버 주소
DATA_DIR=data                      # 로컬 작업 데이터 폴더 (.gitignore)
LOCAL_DB_PATH=data/app.db          # 로컬 SQLite (작업 중 데이터·판독 결과·캐시)
SOFFICE_PATH=                      # LibreOffice soffice 실행 파일 (엑셀→PDF 변환, 기본 위치면 비움)

# ─────────────────────────────────────────────
# 2. AI (core/llm.py 한 곳에서만 사용) — AI는 OpenAI만 사용(HS 결정 11/26)
#    예전 AI_PROVIDER·ANTHROPIC_API_KEY·CLAUDE_MODEL 줄은 더 쓰지 않는다(남아 있어도 무시됨)
# ─────────────────────────────────────────────
LLM_ENABLED=true                   # false면 AI 호출 없이 규칙만으로 동작
OPENAI_API_KEY=
OPENAI_MODEL=                      # 비우면 core/llm.py 기본값. 화면(연결 설정 › AI 모델)에서 고른 값이 우선
MASK_SHIPPER_NAMES=true            # LLM으로 보내기 전 화주명 가리기 (core/masking.py). 끄지 않는다
# GEMINI_API_KEY=                  # 기존 도구는 Gemini로 판독함. 우리 팀은 쓰지 않음 (연계 시험용, 선택)

# ─────────────────────────────────────────────
# 3. 구글 (드라이브 = 실무 기준 저장소, Gmail = 만료 알림)
# ─────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials.json   # OAuth 데스크톱 앱 클라이언트 (커밋 금지)
GOOGLE_TOKEN_FILE=token.json               # 로그인 후 자동 생성 (커밋 금지)
DRIVE_INBOX_FOLDER_ID=             # '서류 접수 (공유본)' 폴더. 운영용 폴더 ID는 넣지 않는다
DRIVE_LAW_FOLDER_ID=               # '법령자료 (공유본)' 폴더
STUDENT_DATA_FOLDER_ID=            # '검역 데이터 (공유본)' 폴더 (SAMC 업무 기록 JSON)
SPREADSHEET_ID=                    # '검역 이력 (공유본)' 시트 (기존 도구 연계용, 사용 여부 확인 필요)
ITEM_SPREADSHEET_ID=               # '품목사항 (공유본)' 시트 (기존 도구 연계용, 사용 여부 확인 필요)
GMAIL_SENDER=                      # 만료 알림 발신 계정
ALERT_EMAIL_TO=                    # 만료 알림 수신자 (쉼표로 여러 명)
ALERT_DAYS_BEFORE=90,30            # 실적·해외제조업소 코드 만료 알림 시점 (미팅 11/24: 3개월 전·1개월 전)
FACTORY_CODE_VALID_YEARS=2         # 해외제조업소 코드 유효기간(년): 등록(갱신)일 + 2년. 근거 수입식품안전관리 특별법 시행규칙 — 최신본 확인 필요 (A2-5)

# ─────────────────────────────────────────────
# 4. 관세청 유니패스 (계정 받기 전에는 UNIPASS_MODE=mock)
# ─────────────────────────────────────────────
UNIPASS_MODE=mock                  # mock | live. 신청서 작성·전송 기능은 만들지 않는다
UNIPASS_CARGO_API_KEY=             # 화물통관진행정보 (반입 상태·반입일·반입지)
UNIPASS_CUSTOMS_CHECK_API_KEY=     # 세관장 확인대상물품조회
UNIPASS_INSPECTION_API_KEY=        # 검사검역내역조회 (승인일·결정일)
UNIPASS_SHED_API_KEY=              # 장치장정보조회
UNIPASS_FXRT_API_KEY=              # 관세환율 (가격(USD) 계산)
UNIPASS_REQ_STATUS_API_KEY=        # 통관단일창구 처리이력조회

# ─────────────────────────────────────────────
# 5. 공공 데이터 (공개 정보 → Supabase 적재 대상)
# ─────────────────────────────────────────────
LAW_API_OC=                        # 법제처 OPEN API. 등록한 공인 IP에서만 동작 (PC마다 등록)
DATA_GO_KR_SERVICE_KEY=            # 공공데이터포털 일반 인증키 (Decoding)
MFDS_MATERIAL_CODE_API_KEY=        # 식약처 재질 코드(성분코드)
MFDS_IMPORT_RCPT_ENTP_API_KEY=     # 식약처 수입신고 접수 업체
MFDS_OVERSEAS_MAKER_API_KEY=       # 식약처 해외제조업소 정보
FOODSAFETY_API_KEY=                # 식품안전나라 (I0940 기구 및 용기·포장 공전 등)

# ─────────────────────────────────────────────
# 6. Supabase (공개 정보만. 화주명·화주 서류 데이터 금지)
# ─────────────────────────────────────────────
SUPABASE_URL=https://cqxmndycpbozjfrtlvbi.supabase.co 
SUPABASE_ANON_KEY=                 # 팀원용: 읽기 전용 (RLS로 SELECT만 허용)
SUPABASE_SERVICE_ROLE_KEY=         # PM(KHS)만 보관. 적재·마이그레이션용. 팀원 .env에는 넣지 않는다
